# boss-hr 评分 v2 LLM 持久化用户配置示例
# =====================================================
# 真实文件位置：
#   Windows:  C:\Users\<用户名>\.boss-hr\llm.env
#   POSIX:    ~/.boss-hr/llm.env
# 复制本示例文件到上述路径，填写 4 个必填 + 1 个可选；
# 示例中的占位文本必须替换为真实值，**禁止在仓库提交真实 key**。
#
# 字段说明：
#   BOSS_HR_LLM_BASE_URL    OpenAI-compatible base URL（必填）
#       中国区：https://api.minimaxi.com/v1
#       国际区：https://api.minimax.io/v1
#   BOSS_HR_LLM_API_KEY     服务端 API key（必填；永不提交到仓库）
#   BOSS_HR_LLM_MODEL       模型名（必填，如 MiniMax-M3）
#   BOSS_HR_LLM_TIMEOUT     单次请求超时秒数（必填，推荐 120 秒，可根据端点响应速度调整）
#   BOSS_HR_LLM_MAX_RETRIES 429 / 5xx / 网络 / 超时的额外重试次数（可选，缺失时默认 2）
#
# 配置优先级：
#   进程环境变量（BOSS_HR_LLM_*）逐字段覆盖本文件；
#   空字符串环境变量视为未设置，不会"清空"文件中的值；
#   加载过程绝不写回操作系统环境变量。
#
# 安全约束：
#   本文件**只允许**这 5 个字段；任何其它字段（含
#   BOSS_HR_LLM_TEST_HOOK / BOSS_HR_LLM_TEST_HOOK_ALLOWLIST /
#   BOSS_HR_OUTPUT_DIR / 模块路径）一律让整份加载失败。
#   test hook 仍只能走代码内静态白名单（tests.cli._mock_llm_hook），
#   不可通过本文件注入。

BOSS_HR_LLM_BASE_URL=https://api.minimaxi.com/v1
BOSS_HR_LLM_API_KEY=请填写
BOSS_HR_LLM_MODEL=MiniMax-M3
BOSS_HR_LLM_TIMEOUT=120
BOSS_HR_LLM_MAX_RETRIES=2
